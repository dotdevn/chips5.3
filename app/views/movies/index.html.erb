<!--  This file is app/views/movies/index.html.erb -->
<p style="color: green"><%= notice %></p>

<h1>Movies</h1>

<%= form_tag movies_path, method: :get, id: "ratings_form", local: true do %>
  <%= hidden_field_tag :filter_submitted, "1" %>
  <fieldset>
    <legend>Include:</legend>
    <% @all_ratings.each do |rating| %>
      <div class="form-check form-check-inline">
        <%= check_box_tag "ratings[#{rating}]", "1", @ratings_to_show.include?(rating), id: "ratings_#{rating}", class: "form-check-input" %>
        <%= label_tag "ratings_#{rating}", rating, class: "form-check-label" %>
      </div>
    <% end %>
  </fieldset>
  <div>
    <%= label_tag :sort_by, "Sort by:", class: "form-label me-2" %>
    <%= select_tag :sort_by,
                   options_for_select([["Title", "title"], ["Release Date", "release_date"]], @sort_by),
                   id: "sort_by", class: "form-select d-inline w-auto" %>
  </div>
  <%= submit_tag "Refresh", id: "ratings_submit", class: "btn btn-primary" %>
<% end %>

<table id="movies">
  <thead>
    <tr>
      <th scope="col" class="<%= "sorted" if @sort_by == "title" %>" aria-sort="<%= @sort_by == "title" ? "ascending" : "none" %>">
        <%= link_to "Title", movies_path(sort_by: "title", ratings: @ratings_for_links), id: "title_header" %>
      </th>
      <th scope="col">Rating</th>
      <th scope="col" class="<%= "sorted" if @sort_by == "release_date" %>" aria-sort="<%= @sort_by == "release_date" ? "ascending" : "none" %>">
        <%= link_to "Release Date", movies_path(sort_by: "release_date", ratings: @ratings_for_links), id: "release_date_header" %>
      </th>
      <th scope="col">More info</th>
    </tr>
  </thead>
  <tbody>
    <% @movies.each do |movie| %>
      <tr id="<%= dom_id movie %>">
        <td><%= movie.title %></td>
        <td><%= movie.rating %></td>
        <td><%= movie.release_date&.strftime("%Y-%m-%d") %></td>
        <td><%= link_to "More about #{movie.title}", movie %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "New movie", new_movie_path %>
